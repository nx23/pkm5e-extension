{
  "manifest_version": 3,
  "name": "Pokemon 5e Roll20",
  "description": "Enable integration with Roll20 for Pokemon 5e.",
  "version": "1.3",
  "icons": {
    "16": "assets/icon-16.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://poke5e.app/*",
    "https://roll20.net/*",
    "https://app.roll20.net/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://poke5e.app/*", "http://poke5e.app/*"],
      "js": ["utils/logger.js", "utils/storage.js", "utils/dataParser.js", "utils/clickInjector.js", "content-scripts/poke5e.js"],
      "css": ["styles/poke5e-overlay.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://roll20.net/*", "https://app.roll20.net/*"],
      "js": ["utils/logger.js", "content-scripts/roll20.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Pokemon 5e Roll20 Integration"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/d20.png", "assets/d20-adv.png", "assets/d20-dadv.png"],
      "matches": ["https://poke5e.app/*", "http://poke5e.app/*"]
    }
  ]
}

